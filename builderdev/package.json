{
  "name": "builderdev",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "node server.mjs",
    "docker-start": "npm run setup && npm run start",
    "setup": "node -e \"const fs = require('node:fs'); fs.mkdirSync('prisma', { recursive: true }); fs.closeSync(fs.openSync('prisma/dev.sqlite', 'a'));\" && prisma generate && prisma migrate deploy && node -e \"console.log('Prisma client generated for legacy session fallback; Shopify sessions use MongoDB.')\"",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-router/dev": "7.15.1",
    "@react-router/express": "7.15.1",
    "@react-router/fs-routes": "7.15.1",
    "@react-router/node": "7.15.1",
    "@react-router/serve": "7.15.1",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/cli": "3.88.1",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/shopify-api": "13.1.0",
    "@shopify/shopify-app-react-router": "1.2.1",
    "@shopify/shopify-app-session-storage-prisma": "9.0.1",
    "axios": "^1.13.2",
    "compression": "1.8.1",
    "dotenv": "^16.6.1",
    "express": "4.22.2",
    "isbot": "^5.1.31",
    "mongodb": "^6.21.0",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.15.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "lodash": "4.18.1",
    "p-map": "^4.0.0"
  },
  "author": "abdulhayee"
}
