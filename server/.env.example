NODE_ENV=development
PORT=8081
FORCE_HTTPS=true
MONGO_URI=
# Keep the Shopify frontend and backend on the same isolated session store.
SHOPIFY_SESSION_MONGO_URI=
SHOPIFY_SESSION_MONGO_DB=orderx
SHOPIFY_SESSION_COLLECTION=shopify_sessions_orderx2_dev
SHOPIFY_TOKEN_LOCK_COLLECTION=shopify_token_locks_orderx2_dev
# Set true after moving production to a replica set to fail closed if
# transactional token storage becomes unavailable.
SHOPIFY_TOKEN_REQUIRE_TRANSACTIONS=false
APP_URL=https://api.orderxapp.com
HOST=https://api.orderxapp.com
SHOPIFY_APP_URL=https://app.orderxapp.com
CORS_ALLOWED_ORIGINS=https://app.orderxapp.com
INTERNAL_SYNC_SECRET=
WA_TOKEN_SECRET=
SHOPIFY_API_KEY=7e3384419f778351adcc91535750b652
SHOPIFY_CLIENT_ID=7e3384419f778351adcc91535750b652
SHOPIFY_API_SECRET=
SCOPES=read_fulfillments,read_customers,read_products,write_order_edits,read_order_edits,read_orders,write_orders
BILLING_CURRENCY=USD
BILLING_ORDERX_METERED_4_PRICE=2.99
BILLING_ORDERX_METERED_USAGE_AMOUNT=0.01
BILLING_ORDERX_METERED_USAGE_CAP=30
BILLING_ORDERX_METERED_USAGE_CAP_MESSAGES=3000
BILLING_ORDERX_FREE_CONFIRMATION_CAP=10
BILLING_ORDERX_METERED_USAGE_CURRENCY=USD
BILLING_OWN_NUMBER_FREE_TRIAL_DAYS=7
BILLING_OWN_NUMBER_FREE_TRIAL_MESSAGES=200
BILLING_OWN_NUMBER_STARTER_5_PRICE=5
BILLING_OWN_NUMBER_STARTER_5_OUTBOUND_CAP=2500
BILLING_OWN_NUMBER_STARTER_5_USAGE_CAP=100
BILLING_OWN_NUMBER_SCALE_10_PRICE=10
BILLING_OWN_NUMBER_SCALE_10_OUTBOUND_CAP=7500
BILLING_OWN_NUMBER_SCALE_10_USAGE_CAP=100
BILLING_OWN_NUMBER_UNLIMITED_15_PRICE=20
BILLING_OWN_NUMBER_OVERAGE_AMOUNT=0.01
DEFAULT_STORE_COUNTRY_CODE=PK
BYON_META_TEMPLATE_ESTIMATED_USD=0.01
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_PHONE_NUMBER=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# Meta Embedded Signup configuration required for BYON onboarding.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_SOLUTION_ID=
META_GRAPH_VERSION=v25.0
# WhatsApp Business App coexistence. Meta must grant the app the required
# advanced WhatsApp management and messaging permissions.
META_EMBEDDED_SIGNUP_FEATURE_TYPE=whatsapp_business_app_onboarding

WA_TEMPLATE_COD_CONFIRM=orderx_cod_confirm_new
WA_TEMPLATE_LANG=en
WA_TEMPLATE_LANG_COD_CONFIRMED=en

# Production safety. Never enable unsigned/unauthenticated fallbacks in prod.
ALLOW_UNAUTH_INTERNAL=false
ALLOW_UNSIGNED_WA_WEBHOOK=false
MONGO_AUTO_INDEX=false

# Admin console. Prefer salted scrypt hashes; do not store plaintext passwords.
ADMIN_LOGIN_ID=
ADMIN_JWT_SECRET=
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_SECOND_FACTOR_SALT=
ADMIN_SECOND_FACTOR_HASH=
